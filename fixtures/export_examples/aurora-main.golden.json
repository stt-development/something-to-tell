  "dialogues": [
    {
      "aggregate_version": 1,
      "node_id": "node-dock-dialogue",
      "document": {
        "dialogue_version": 1,
        "entry_element_id": "line-dockmaster-warning",
        "participants": [
          "node-dockmaster",
          "node-hero"
        ],
        "elements": [
          {
            "id": "line-dockmaster-warning",
            "kind": "line",
            "speaker_node_id": "node-dockmaster",
            "text": "No vessel leaves Glass Harbor while the silver embargo is in force.",
            "next_element_id": "line-mara-challenge"
          },
          {
            "id": "line-mara-challenge",
            "kind": "line",
            "speaker_node_id": "node-hero",
            "text": "Your guild forged that order. I can prove it or sail through it.",
            "next_element_id": "choice-mara-response"
          },
          {
            "id": "choice-mara-response",
            "kind": "choice",
            "prompt": "How does Mara answer the dockmaster?",
            "options": [
              {
                "id": "answer-show-ledger",
                "text": "Show Ilya the sealed ledger.",
                "condition": "items.node-sealed-ledger.holder.node_id == \"node-dockmaster\"",
                "next_element_id": "line-ilya-concedes"
              },
              {
                "id": "answer-run-blockade",
                "text": "Order the crew to run the blockade.",
                "condition": "",
                "next_element_id": "line-mara-orders-run"
              }
            ]
          },
          {
            "id": "line-ilya-concedes",
            "kind": "line",
            "speaker_node_id": "node-dockmaster",
            "text": "Those seals are genuine. I will delay the patrol while you depart.",
            "next_element_id": null
          },
          {
            "id": "line-mara-orders-run",
            "kind": "line",
            "speaker_node_id": "node-hero",
            "text": "Cast off. Full power, and keep the inspection boats in our wake.",
            "next_element_id": null
          }
        ]
      }
    }
  ],
