# Local development defaults.
NARRATIVE_RUNTIME_HOST=127.0.0.1
NARRATIVE_RUNTIME_PORT=8000
NARRATIVE_PROJECTS_DIR=./projects

# Legacy application-level profiles remain readable for compatibility.
STT_RUNTIME_STORAGE_PROFILES_FILE=~/.narrative/storage-profiles.json
# New project-owned encrypted profiles use this non-portable per-user key.
STT_RUNTIME_STORAGE_MASTER_KEY_FILE=~/.narrative/storage.key
